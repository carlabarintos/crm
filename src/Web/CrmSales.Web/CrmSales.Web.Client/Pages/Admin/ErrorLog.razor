@page "/admin/error-log"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@attribute [Authorize(Roles = "SuperAdmin")]
@using CrmSales.Web.Client.Services
@inject CrmApiClient Api

<PageTitle>System Error Log</PageTitle>

<div class="page-header stagger-1">
    <div>
        <p class="page-header-meta">Super Admin</p>
        <h1>System Error Log</h1>
    </div>
</div>

<div class="card stagger-2" style="padding:14px 16px;margin-bottom:16px">
    <div class="error-filters">
        <input class="form-control form-control-sm" placeholder="Search error messages, paths, actors…"
               @bind="_search" @bind:event="oninput" @onkeyup="OnSearchKey" style="min-width:200px;flex:1" />
        <button class="btn btn-sm btn-primary" @onclick="ApplyFilters">Apply</button>
        <button class="btn btn-sm btn-outline-secondary" @onclick="ResetFilters">Reset</button>
    </div>
</div>

@if (_data is null)
{
    <div class="text-center py-4"><div class="spinner-border" role="status"></div></div>
}
else if (!_data.Items.Any())
{
    <div class="empty-state">
        <svg width="48" height="48" viewBox="0 0 48 48" fill="none" stroke="#D1D5DB" stroke-width="1.5">
            <circle cx="24" cy="24" r="20" />
            <path d="M24 16v9M24 30v2" stroke-linecap="round" />
        </svg>
        <p class="mt-3 text-muted">No system errors recorded.</p>
    </div>
}
else
{
    <div class="card stagger-3" style="overflow:hidden">
        <div class="error-timeline">
            @foreach (var e in _data.Items)
            {
                <div class="error-row">
                    <div class="error-icon-col">
                        <div class="error-icon">
                            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8">
                                <circle cx="8" cy="8" r="6.5" />
                                <path d="M8 5v3.5M8 10.5v.5" stroke-linecap="round" />
                            </svg>
                        </div>
                        <div class="error-line"></div>
                    </div>
                    <div class="error-body">
                        <div class="error-body-top">
                            <span class="badge badge-soft-danger">system.error</span>
                            <span class="error-path" title="@e.EntityType">@TruncatePath(e.EntityType)</span>
                            <span class="error-actor">@e.Actor</span>
                            <span class="error-time">@FormatTime(e.OccurredAt)</span>
                        </div>
                        <div class="error-desc">@e.Description</div>
                        <div class="error-trace">Trace: @e.EntityId</div>
                    </div>
                </div>
            }
        </div>
    </div>

    @if (_data.Total > _data.PageSize)
    {
        var totalPages = (int)Math.Ceiling((double)_data.Total / _data.PageSize);
        <div class="d-flex justify-content-between align-items-center mt-3 stagger-4">
            <span class="text-muted small">@_data.Total errors total</span>
            <div class="d-flex gap-2">
                <button class="btn btn-sm btn-outline-secondary" disabled="@(_page <= 1)" @onclick="PrevPage">← Prev</button>
                <span class="btn btn-sm btn-light disabled">@_page / @totalPages</span>
                <button class="btn btn-sm btn-outline-secondary" disabled="@(_page >= totalPages)" @onclick="NextPage">Next →</button>
            </div>
        </div>
    }
}

<style>
    .error-filters {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
    }

    .empty-state { text-align: center; padding: 5rem 1.5rem; }
    .empty-state p { font-size: 14px; }

    .error-timeline { padding: 8px 0; }

    .error-row {
        display: flex;
        gap: 0;
        padding: 0 20px;
    }

    .error-icon-col {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 36px;
        flex-shrink: 0;
        padding-top: 14px;
    }

    .error-icon {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: #FEE2E2;
        color: #DC2626;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        z-index: 1;
    }

    .error-icon svg { width: 13px; height: 13px; }

    .error-line {
        width: 2px;
        flex: 1;
        background: #F3F4F6;
        margin: 4px 0;
        min-height: 12px;
    }

    .error-row:last-child .error-line { display: none; }

    .error-body {
        flex: 1;
        padding: 12px 0 12px 14px;
        border-bottom: 1px solid #F9FAFB;
        min-width: 0;
    }

    .error-row:last-child .error-body { border-bottom: none; }

    .error-body-top {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 4px;
    }

    .error-path {
        font-size: 12px;
        color: #6B7280;
        background: #F3F4F6;
        border-radius: 4px;
        padding: 1px 6px;
        font-family: monospace;
        max-width: 260px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .error-actor {
        font-size: 12px;
        font-weight: 600;
        color: #374151;
    }

    .error-time {
        font-size: 11px;
        color: #9CA3AF;
        margin-left: auto;
        white-space: nowrap;
    }

    .error-desc {
        font-size: 13px;
        color: #4B5563;
        line-height: 1.4;
        word-break: break-word;
    }

    .error-trace {
        font-size: 11px;
        color: #9CA3AF;
        font-family: monospace;
        margin-top: 2px;
    }

    .badge-soft-danger { background: #FEE2E2; color: #991B1B; }

    @@media (max-width: 640.98px) {
        .error-row { padding: 0 10px; }
        .error-time { margin-left: 0; width: 100%; }
        .error-body-top { gap: 5px; }
    }
</style>

@code {
    private ErrorLogPageDto? _data;
    private int _page = 1;
    private string _search = "";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _data = null;
        _data = await Api.GetErrorLogsAsync(page: _page, pageSize: 20, search: NullIfEmpty(_search));
    }

    private async Task ApplyFilters() { _page = 1; await LoadAsync(); }
    private async Task ResetFilters() { _search = ""; _page = 1; await LoadAsync(); }
    private async Task OnSearchKey(KeyboardEventArgs e) { if (e.Key == "Enter") await ApplyFilters(); }
    private async Task PrevPage() { _page--; await LoadAsync(); }
    private async Task NextPage() { _page++; await LoadAsync(); }

    private static string? NullIfEmpty(string s) => string.IsNullOrWhiteSpace(s) ? null : s;

    private static string TruncatePath(string path)
        => path.Length > 40 ? "…" + path[^37..] : path;

    private static string FormatTime(DateTime dt)
    {
        var local = dt.ToLocalTime();
        var diff = DateTime.Now - local;
        if (diff.TotalMinutes < 1) return "just now";
        if (diff.TotalHours < 1) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalDays < 1) return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays < 7) return local.ToString("ddd HH:mm");
        return local.ToString("MMM d, HH:mm");
    }
}
