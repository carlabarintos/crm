@page "/services"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using CrmSales.Web.Client.Services
@using Microsoft.AspNetCore.Components.Forms
@inject CrmApiClient Api
@inject IJSRuntime JS

<PageTitle>Services</PageTitle>

<div class="page-header stagger-1">
    <div>
        <p class="page-header-meta">Catalog</p>
        <h1>Services</h1>
    </div>
    <div class="d-flex gap-2 align-items-center flex-wrap">
        <AuthorizeView Roles="Admin">
            <button class="btn btn-outline-secondary btn-sm" @onclick="DownloadTemplate">
                <svg width="13" height="13" viewBox="0 0 13 13" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-right:4px;vertical-align:-1px"><path d="M6.5 1v7M4 6l2.5 2.5L9 6" stroke-linecap="round" stroke-linejoin="round"/><path d="M1 10v1a1 1 0 001 1h9a1 1 0 001-1v-1" stroke-linecap="round"/></svg>
                CSV Template
            </button>
            <button class="btn btn-outline-primary btn-sm" @onclick="() => { _showImport = !_showImport; ResetImport(); }">
                Import CSV
            </button>
            <a href="/services/new" class="btn btn-primary btn-sm">+ New Service</a>
        </AuthorizeView>
    </div>
</div>

<!-- CSV Import Panel -->
@if (_showImport)
{
    <div class="card mb-4 stagger-2">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="mb-0">Import Services from CSV</h6>
            <span class="text-muted" style="font-size:11.5px">Max 200 rows · Matched by Service Code (existing skipped)</span>
        </div>
        <div class="card-body">
            @if (_importResult is null)
            {
                <div class="mb-3">
                    <label class="form-label">Select CSV file</label>
                    <InputFile class="form-control" accept=".csv,text/csv" OnChange="OnFileSelected" />
                    @if (!string.IsNullOrEmpty(_importParseError))
                    {
                        <div class="text-danger small mt-1">@_importParseError</div>
                    }
                </div>

                @if (_importPreview.Count > 0)
                {
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted small">Preview — @_importPreview.Count row@(_importPreview.Count == 1 ? "" : "s") ready to import</span>
                        </div>
                        <div class="table-responsive" style="max-height:240px;overflow-y:auto">
                            <table class="table table-sm table-bordered mb-0" style="font-size:12px">
                                <thead class="table-light sticky-top">
                                    <tr><th>#</th><th>Name</th><th>Service Code</th><th>Price</th><th>Currency</th><th>Unit</th><th>Duration (min)</th><th>Category</th></tr>
                                </thead>
                                <tbody>
                                    @{ int rn = 0; }
                                    @foreach (var row in _importPreview)
                                    {
                                        rn++;
                                        bool hasError = string.IsNullOrWhiteSpace(row.Name) || string.IsNullOrWhiteSpace(row.ServiceCode) || row.Price <= 0;
                                        <tr class="@(hasError ? "table-warning" : "")">
                                            <td class="text-muted">@rn</td>
                                            <td>@row.Name</td>
                                            <td style="font-family:monospace">@row.ServiceCode</td>
                                            <td>@row.Price.ToString("F2")</td>
                                            <td>@row.Currency</td>
                                            <td>@(row.UnitOfMeasure ?? "—")</td>
                                            <td>@(row.EstimatedDurationMinutes?.ToString() ?? "—")</td>
                                            <td style="color:#6B7280">@(row.CategoryName ?? "—")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <button class="btn btn-primary btn-sm" @onclick="RunImport" disabled="@_importing">
                        @if (_importing) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Import @_importPreview.Count @(_importPreview.Count == 1 ? "service" : "services")
                    </button>
                    <button class="btn btn-outline-secondary btn-sm ms-2" @onclick="ResetImport">Clear</button>
                }
            }
            else
            {
                <div class="import-result">
                    <div class="d-flex gap-3 mb-3 flex-wrap">
                        <div class="import-stat import-stat-success">
                            <div class="import-stat-val">@_importResult.Created</div>
                            <div class="import-stat-lbl">Created</div>
                        </div>
                        <div class="import-stat import-stat-neutral">
                            <div class="import-stat-val">@_importResult.Skipped</div>
                            <div class="import-stat-lbl">Skipped (Code exists)</div>
                        </div>
                        @if (_importResult.Errors.Count > 0)
                        {
                            <div class="import-stat import-stat-danger">
                                <div class="import-stat-val">@_importResult.Errors.Count</div>
                                <div class="import-stat-lbl">Errors</div>
                            </div>
                        }
                    </div>
                    @if (_importResult.Errors.Count > 0)
                    {
                        <div class="alert alert-warning py-2 mb-3" style="font-size:12.5px">
                            @foreach (var e in _importResult.Errors) { <div>Row @e.Row: @e.Reason</div> }
                        </div>
                    }
                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-secondary btn-sm" @onclick="ResetImport">Import another file</button>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => _showImport = false">Close</button>
                    </div>
                </div>
            }
        </div>
    </div>
}

<button type="button" class="mob-section-btn @(_filtersOpen ? "open" : "")" @onclick="() => _filtersOpen = !_filtersOpen">
    <span>Filters</span>
    <svg class="mob-chevron" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 5l4 4 4-4"/></svg>
</button>
<div class="mob-collapse @(_filtersOpen ? "open" : "")">
<div class="row mb-3 stagger-2">
    <div class="col-md-4">
        <input class="form-control" placeholder="Search by name or service code..." @bind="searchTerm" @onkeyup="OnSearchKey" />
    </div>
    <div class="col-md-2">
        <select class="form-select" @bind="activeFilter" @bind:after="OnFilterChanged">
            <option value="">All</option>
            <option value="true">Active</option>
            <option value="false">Inactive</option>
        </select>
    </div>
</div>
</div>

@if (_loading)
{
    <div class="text-center py-4"><div class="spinner-border" role="status"></div></div>
}
else if (!services.Any())
{
    <div class="alert alert-info">No services found.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var s in services)
        {
            <div class="col">
                <div class="card h-100 @(s.IsActive ? "" : "opacity-50")">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <h5 class="card-title mb-1">@s.Name</h5>
                            @if (!s.IsActive)
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </div>
                        <p class="text-muted small mb-1">Code: <code>@s.ServiceCode</code></p>
                        @if (!string.IsNullOrEmpty(s.UnitOfMeasure))
                        {
                            <p class="text-muted small mb-1">Unit: @s.UnitOfMeasure</p>
                        }
                        @if (s.EstimatedDurationMinutes.HasValue)
                        {
                            <p class="text-muted small mb-1">Duration: @FormatDuration(s.EstimatedDurationMinutes.Value)</p>
                        }
                        <p class="card-text text-muted small">@s.Description</p>
                        <span class="fs-5 fw-bold text-primary">@s.Price.ToString("F2") @s.Currency</span>
                    </div>
                    <div class="card-footer">
                        <a href="/services/@s.Id" class="btn btn-sm btn-outline-primary">View Details</a>
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (hasMore)
{
    <div class="text-center py-3">
        <button class="btn btn-outline-primary" @onclick="LoadMore" disabled="@isLoadingMore">
            @if (isLoadingMore) { <span class="spinner-border spinner-border-sm me-1"></span> }
            Load More
        </button>
    </div>
}

<style>
    .import-stat {
        display: flex; flex-direction: column; align-items: center;
        padding: .6rem 1.25rem; border-radius: 10px; min-width: 80px;
    }
    .import-stat-val { font-size: 1.5rem; font-weight: 700; line-height: 1.1; }
    .import-stat-lbl { font-size: 10.5px; color: #6B7280; margin-top: 2px; white-space: nowrap; }
    .import-stat-success { background: #ECFDF5; }
    .import-stat-success .import-stat-val { color: #059669; }
    .import-stat-neutral { background: #F9FAFB; }
    .import-stat-neutral .import-stat-val { color: #374151; }
    .import-stat-danger { background: #FEF2F2; }
    .import-stat-danger .import-stat-val { color: #DC2626; }
</style>

@code {
    private List<ServiceDto> services = [];
    private string searchTerm = "";
    private string activeFilter = "";
    private string? cursor;
    private bool hasMore;
    private bool isLoadingMore;
    private bool _filtersOpen = true;
    private bool _loading = true;

    private record ServiceImportRow(string Name, string ServiceCode, string? Description, decimal Price, string Currency, string? UnitOfMeasure, int? EstimatedDurationMinutes, string? CategoryName);

    protected override async Task OnInitializedAsync() => await LoadServices();

    private async Task OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") { cursor = null; await LoadServices(); }
    }

    private async Task OnFilterChanged() { cursor = null; await LoadServices(); }

    private async Task LoadServices()
    {
        _loading = true;
        bool? isActive = activeFilter switch { "true" => true, "false" => false, _ => null };
        var result = await Api.GetServicesAsync(
            string.IsNullOrWhiteSpace(searchTerm) ? null : searchTerm, isActive, 20, cursor);
        if (cursor is null) services = result?.Items ?? [];
        else services.AddRange(result?.Items ?? []);
        cursor = result?.NextCursor;
        hasMore = result?.HasMore ?? false;
        _loading = false;
    }

    private async Task LoadMore()
    {
        if (isLoadingMore || !hasMore) return;
        isLoadingMore = true;
        try
        {
            bool? isActive = activeFilter switch { "true" => true, "false" => false, _ => null };
            var result = await Api.GetServicesAsync(
                string.IsNullOrWhiteSpace(searchTerm) ? null : searchTerm, isActive, 20, cursor);
            services.AddRange(result?.Items ?? []);
            cursor = result?.NextCursor;
            hasMore = result?.HasMore ?? false;
        }
        finally { isLoadingMore = false; }
    }

    private static string FormatDuration(int minutes) =>
        minutes >= 60 ? $"{minutes / 60}h {minutes % 60}m".TrimEnd(' ', 'm', '0').TrimEnd() : $"{minutes}m";

    // ── CSV Import ────────────────────────────────────────────────────────────

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        _importParseError = null;
        _importPreview = [];
        _importResult = null;

        var file = e.File;
        if (file.Size > MaxFileSizeBytes)
        {
            _importParseError = "File too large. Maximum size is 512 KB.";
            return;
        }

        try
        {
            using var stream = file.OpenReadStream(MaxFileSizeBytes);
            using var reader = new System.IO.StreamReader(stream);
            var content = await reader.ReadToEndAsync();
            var rows = ParseServiceCsv(content);

            if (rows.Count > MaxImportRows)
            {
                _importParseError = $"CSV contains {rows.Count} data rows. Maximum is {MaxImportRows}.";
                return;
            }

            _importPreview = rows;
        }
        catch (Exception ex)
        {
            _importParseError = $"Failed to read file: {ex.Message}";
        }
    }

    private static List<ServiceImportRow> ParseServiceCsv(string content)
    {
        var result = new List<ServiceImportRow>();
        var lines = content.Split('\n', StringSplitOptions.RemoveEmptyEntries);
        bool isFirst = true;

        foreach (var rawLine in lines)
        {
            var line = rawLine.TrimEnd('\r').Trim();
            if (string.IsNullOrEmpty(line)) continue;

            var cols = SplitCsvLine(line);

            if (isFirst)
            {
                isFirst = false;
                if (cols.Count > 0 && cols[0].Trim().Equals("Name", StringComparison.OrdinalIgnoreCase))
                    continue;
            }

            var name        = cols.Count > 0 ? cols[0].Trim() : "";
            var code        = cols.Count > 1 ? cols[1].Trim() : "";
            var desc        = cols.Count > 2 ? cols[2].Trim() : "";
            var priceStr    = cols.Count > 3 ? cols[3].Trim() : "0";
            var currency    = cols.Count > 4 ? cols[4].Trim().ToUpperInvariant() : "USD";
            var unit        = cols.Count > 5 ? cols[5].Trim() : "";
            var durationStr = cols.Count > 6 ? cols[6].Trim() : "";
            var catName     = cols.Count > 7 ? cols[7].Trim() : "";

            decimal.TryParse(priceStr, System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture, out var price);
            int? duration = int.TryParse(durationStr, out var d) ? d : null;
            if (string.IsNullOrEmpty(currency)) currency = "USD";

            result.Add(new ServiceImportRow(
                name, code,
                string.IsNullOrEmpty(desc) ? null : desc,
                price, currency,
                string.IsNullOrEmpty(unit) ? null : unit,
                duration,
                string.IsNullOrEmpty(catName) ? null : catName));
        }

        return result;
    }

    private static List<string> SplitCsvLine(string line)
    {
        var result = new List<string>();
        var sb = new System.Text.StringBuilder();
        bool inQuotes = false;

        for (int i = 0; i < line.Length; i++)
        {
            char c = line[i];
            if (c == '"')
            {
                if (inQuotes && i + 1 < line.Length && line[i + 1] == '"') { sb.Append('"'); i++; }
                else inQuotes = !inQuotes;
            }
            else if (c == ',' && !inQuotes) { result.Add(sb.ToString()); sb.Clear(); }
            else sb.Append(c);
        }
        result.Add(sb.ToString());
        return result;
    }

    private async Task RunImport()
    {
        if (_importPreview.Count == 0) return;
        _importing = true;
        try
        {
            var payload = _importPreview.Select(r => new
            {
                r.Name, r.ServiceCode, r.Description, r.Price, r.Currency,
                r.UnitOfMeasure, r.EstimatedDurationMinutes, r.CategoryName
            }).ToList();

            var resp = await Api.ImportServicesAsync(payload);
            if (resp.IsSuccessStatusCode)
            {
                _importResult = await resp.Content.ReadFromJsonAsync<ImportResult>();
                cursor = null;
                await LoadServices();
            }
            else
            {
                _importParseError = $"Import failed: {await resp.Content.ReadAsStringAsync()}";
            }
        }
        finally { _importing = false; }
    }

    private void ResetImport()
    {
        _importPreview = [];
        _importParseError = null;
        _importResult = null;
    }

    private async Task DownloadTemplate()
    {
        var csv = "Name,ServiceCode,Description,Price,Currency,UnitOfMeasure,EstimatedDurationMinutes,CategoryName\n" +
                  "\"Consulting Service\",CONS-001,\"Professional consulting\",150.00,USD,hours,120,\"Professional Services\"\n" +
                  "\"Design Work\",DESIGN-001,\"UI/UX Design\",200.00,USD,project,,Design";
        await JS.InvokeVoidAsync("downloadCsv", "services_template.csv", csv);
    }

    private const int MaxImportRows = 200;
    private const long MaxFileSizeBytes = 512 * 1024;
    private bool _showImport;
    private bool _importing;
    private string? _importParseError;
    private List<ServiceImportRow> _importPreview = [];
    private ImportResult? _importResult;
}
