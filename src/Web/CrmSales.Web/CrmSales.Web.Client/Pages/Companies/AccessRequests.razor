@page "/access-requests"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@attribute [Authorize(Roles = "SuperAdmin")]
@using CrmSales.Web.Client.Services
@inject CrmApiClient Api

<PageTitle>Access Requests — ZoeIly</PageTitle>

<div class="page-header mb-4">
    <div>
        <h1 class="h3 mb-1">Access Requests</h1>
        <p class="text-muted small mb-0">Review and approve pending workspace requests.</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-sm @(_filter == "Pending" ? "btn-primary" : "btn-outline-secondary")"
                @onclick='() => SetFilter("Pending")'>
            Pending @if (_pendingCount > 0) { <span class="badge bg-white text-primary ms-1">@_pendingCount</span> }
        </button>
        <button class="btn btn-sm @(_filter == "" ? "btn-primary" : "btn-outline-secondary")"
                @onclick='() => SetFilter("")'>All</button>
    </div>
</div>

@if (_loading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else if (_requests is null || !_requests.Any())
{
    <div class="empty-state">
        <svg width="48" height="48" viewBox="0 0 48 48" fill="none" stroke="#D1D5DB" stroke-width="1.5">
            <rect x="6" y="10" width="36" height="30" rx="4" />
            <path d="M14 10V8a4 4 0 0 1 8 0v2M26 10V8a4 4 0 0 1 8 0v2" stroke-linecap="round" />
            <path d="M16 24h16M16 30h10" stroke-linecap="round" />
        </svg>
        <p class="mt-3 text-muted">No @(_filter == "Pending" ? "pending " : "")access requests.</p>
    </div>
}
else
{
    @foreach (var req in _requests)
    {
        <div class="ar-card mb-3">
            <div class="ar-left">
                <div class="ar-avatar">@GetInitial(req.Name)</div>
                <div class="ar-info">
                    <div class="ar-name">@req.Name</div>
                    <div class="ar-company">@req.Company</div>
                    <div class="ar-email">
                        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.3">
                            <rect x="1" y="2.5" width="10" height="7" rx="1" /><path d="M1 4l5 3.5L11 4" stroke-linecap="round" />
                        </svg>
                        @req.Email
                        @if (!string.IsNullOrEmpty(req.Phone))
                        {
                            <span class="ms-2">
                                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.3">
                                    <path d="M2 2.5a1 1 0 0 1 1-1h1.5l1 2.5-1 1a7 7 0 0 0 2.5 2.5l1-1 2.5 1v1.5a1 1 0 0 1-1 1C5 10 2 7 2 2.5z" stroke-linecap="round" />
                                </svg>
                                @req.Phone
                            </span>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(req.Message))
                    {
                        <div class="ar-message">"@req.Message"</div>
                    }
                </div>
            </div>
            <div class="ar-right">
                <span class="badge @GetStatusBadge(req.Status)">@req.Status</span>
                <div class="ar-time">@FormatTime(req.RequestedAt)</div>
                @if (req.Status == "Pending")
                {
                    <div class="d-flex gap-2 mt-2">
                        <button class="btn btn-sm btn-success"
                                @onclick="() => ApproveAsync(req)"
                                disabled="@(_actionId == req.Id)">
                            @if (_actionId == req.Id && _actionType == "approve")
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            Approve
                        </button>
                        <button class="btn btn-sm btn-outline-danger"
                                @onclick="() => RejectAsync(req)"
                                disabled="@(_actionId == req.Id)">
                            @if (_actionId == req.Id && _actionType == "reject")
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            Reject
                        </button>
                    </div>
                }
                @if (_approveResult?.RequestId == req.Id)
                {
                    <div class="ar-result mt-2">
                        <div class="ar-result-title">Workspace created</div>
                        <div>Slug: <code>@_approveResult.Slug</code></div>
                        <div>Temp password: <code>@_approveResult.TempPassword</code></div>
                        <div class="ar-result-hint">Share with the user — they must change it on first login.</div>
                    </div>
                }
            </div>
        </div>
    }
}

@if (!string.IsNullOrEmpty(_globalError))
{
    <div class="alert alert-danger mt-3">@_globalError</div>
}

<style>
    .page-header { display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem; }

    .empty-state { text-align: center; padding: 5rem 1.5rem; }
    .empty-state p { font-size: 14px; }

    .ar-card {
        background: #fff; border: 1px solid #E5E7EB;
        border-radius: 14px; padding: 1.25rem 1.5rem;
        display: flex; justify-content: space-between; align-items: flex-start; gap: 1.5rem;
    }
    .ar-left { display: flex; gap: 1rem; align-items: flex-start; flex: 1; min-width: 0; }
    .ar-avatar {
        width: 44px; height: 44px; border-radius: 50%;
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        color: #fff; font-size: 17px; font-weight: 700;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
    }
    .ar-info { min-width: 0; }
    .ar-name { font-size: 15px; font-weight: 700; color: #111827; }
    .ar-company { font-size: 13px; font-weight: 600; color: #4B5563; margin-top: 1px; }
    .ar-email {
        display: flex; align-items: center; gap: 4px;
        font-size: 12px; color: #9CA3AF; margin-top: 4px;
        flex-wrap: wrap;
    }
    .ar-message {
        font-size: 13px; color: #6B7280;
        font-style: italic; margin-top: 6px;
        max-width: 480px; line-height: 1.5;
    }
    .ar-right {
        display: flex; flex-direction: column; align-items: flex-end;
        flex-shrink: 0; gap: 4px; min-width: 140px;
    }
    .ar-time { font-size: 11px; color: #9CA3AF; }

    .ar-result {
        background: #F0FDF4; border: 1px solid #BBF7D0;
        border-radius: 8px; padding: .75rem 1rem;
        font-size: 12px; text-align: right; line-height: 1.7;
    }
    .ar-result code { font-size: 11.5px; background: #dcfce7; padding: 1px 5px; border-radius: 4px; }
    .ar-result-title { font-weight: 700; color: #166534; margin-bottom: 2px; }
    .ar-result-hint { font-size: 11px; color: #16a34a; margin-top: 4px; }

    @@media (max-width: 640px) {
        .ar-card { flex-direction: column; }
        .ar-right { align-items: flex-start; }
    }
</style>

@code {
    private List<AccessRequestDto>? _requests;
    private bool _loading = true;
    private string _filter = "Pending";
    private int _pendingCount;
    private Guid? _actionId;
    private string? _actionType;
    private string? _globalError;
    private ApproveResultDisplay? _approveResult;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task SetFilter(string f) { _filter = f; await LoadAsync(); }

    private async Task LoadAsync()
    {
        _loading = true;
        _approveResult = null;
        try
        {
            _requests = await Api.GetAccessRequestsAsync(_filter == "" ? null : _filter);
            if (_filter != "Pending")
            {
                var pending = await Api.GetAccessRequestsAsync("Pending");
                _pendingCount = pending?.Count ?? 0;
            }
            else
            {
                _pendingCount = _requests?.Count ?? 0;
            }
        }
        finally { _loading = false; }
    }

    private async Task ApproveAsync(AccessRequestDto req)
    {
        _globalError = null;
        _actionId = req.Id;
        _actionType = "approve";
        try
        {
            var resp = await Api.ApproveAccessRequestAsync(req.Id);
            if (resp.IsSuccessStatusCode)
            {
                var result = await resp.Content.ReadFromJsonAsync<ApproveResultResponse>();
                _approveResult = new ApproveResultDisplay(req.Id, result!.Slug, result.TempPassword);
                await LoadAsync();
            }
            else
            {
                _globalError = $"Approval failed: {await ApiErrors.ParseAsync(resp)}";
            }
        }
        catch (Exception ex) { _globalError = ex.Message; }
        finally { _actionId = null; _actionType = null; }
    }

    private async Task RejectAsync(AccessRequestDto req)
    {
        _globalError = null;
        _actionId = req.Id;
        _actionType = "reject";
        try
        {
            var resp = await Api.RejectAccessRequestAsync(req.Id);
            if (resp.IsSuccessStatusCode)
                await LoadAsync();
            else
                _globalError = await ApiErrors.ParseAsync(resp);
        }
        catch (Exception ex) { _globalError = ex.Message; }
        finally { _actionId = null; _actionType = null; }
    }

    private static string GetStatusBadge(string status) => status switch
    {
        "Pending" => "bg-warning text-dark",
        "Approved" => "bg-success",
        "Rejected" => "bg-secondary",
        _ => "bg-light text-dark"
    };

    private static string FormatTime(DateTime dt)
    {
        var diff = DateTime.UtcNow - dt;
        if (diff.TotalMinutes < 1) return "just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalDays < 1) return $"{(int)diff.TotalHours}h ago";
        return dt.ToString("MMM d, yyyy");
    }

    private static string GetInitial(string name)
        => string.IsNullOrEmpty(name) ? "?" : name[0].ToString().ToUpper();

    private record ApproveResultResponse(Guid CompanyId, string CompanyName, string Slug,
        string KeycloakId, string Email, string TempPassword);
    private record ApproveResultDisplay(Guid RequestId, string Slug, string TempPassword);
}
