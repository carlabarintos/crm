@page "/orders/{Id:guid}"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using CrmSales.Web.Client.Services
@inject CrmApiClient Api
@inject NavigationManager Nav

<PageTitle>@(order?.OrderNumber ?? "Order")</PageTitle>

@if (order is null && error is null)
{
    <div class="text-center py-4"><div class="spinner-border" role="status"></div></div>
}
else if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}
else if (order is not null)
{
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/orders">Orders</a></li>
            <li class="breadcrumb-item active">@order.OrderNumber</li>
        </ol>
    </nav>

    <div class="row g-4">
        <!-- Order info -->
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">@order.OrderNumber</h5>
                    <span class="badge @GetStatusBadge(order.Status) fs-6">@order.Status</span>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Quote</dt>
                        <dd class="col-sm-8"><a href="/quotes/@order.QuoteId">@order.QuoteId.ToString()[..8]…</a></dd>

                        @if (order.DiscountTotal > 0 || order.QuoteDiscountPercent > 0)
                        {
                            <dt class="col-sm-4">Subtotal</dt>
                            <dd class="col-sm-8">@order.SubTotal.ToString("F2") @order.Currency</dd>
                        }
                        @if (order.DiscountTotal > 0)
                        {
                            <dt class="col-sm-4">Item Discounts</dt>
                            <dd class="col-sm-8 text-danger">-@order.DiscountTotal.ToString("F2") @order.Currency</dd>
                        }
                        <dt class="col-sm-4">Net Total</dt>
                        <dd class="col-sm-8">@order.TotalAmount.ToString("F2") @order.Currency</dd>

                        @if (order.QuoteDiscountPercent > 0)
                        {
                            <dt class="col-sm-4">Quote Discount (@order.QuoteDiscountPercent.ToString("0.##")%)</dt>
                            <dd class="col-sm-8 text-danger">-@order.QuoteDiscountAmount.ToString("F2") @order.Currency</dd>
                            <dt class="col-sm-4">Taxable Amount</dt>
                            <dd class="col-sm-8">@order.TaxableAmount.ToString("F2") @order.Currency</dd>
                        }
                        @if (order.TaxRatePercent > 0)
                        {
                            <dt class="col-sm-4">@order.TaxRateName (@order.TaxRatePercent.ToString("0.##")%)</dt>
                            <dd class="col-sm-8 text-muted">+@order.TaxAmount.ToString("F2") @order.Currency</dd>
                        }

                        <dt class="col-sm-4">Grand Total</dt>
                        <dd class="col-sm-8 fw-bold text-primary fs-5">@order.GrandTotal.ToString("F2") @order.Currency</dd>

                        <dt class="col-sm-4">Shipping Address</dt>
                        <dd class="col-sm-8">@(order.ShippingAddress ?? "-")</dd>

                        <dt class="col-sm-4">Notes</dt>
                        <dd class="col-sm-8">@(order.Notes ?? "-")</dd>

                        <dt class="col-sm-4">Created</dt>
                        <dd class="col-sm-8">@order.CreatedAt.ToString("MMM dd, yyyy HH:mm")</dd>

                        @if (order.ShippedAt.HasValue)
                        {
                            <dt class="col-sm-4">Shipped</dt>
                            <dd class="col-sm-8">@order.ShippedAt.Value.ToString("MMM dd, yyyy HH:mm")</dd>
                        }
                        @if (order.DeliveredAt.HasValue)
                        {
                            <dt class="col-sm-4">Delivered</dt>
                            <dd class="col-sm-8">@order.DeliveredAt.Value.ToString("MMM dd, yyyy HH:mm")</dd>
                        }
                    </dl>
                </div>
            </div>

            <!-- Line items -->
            <div class="card">
                <div class="card-header"><h6 class="mb-0">Line Items</h6></div>

                @if (showAddLineItem && order.Status == "Pending")
                {
                    <div class="card-body border-bottom">
                        <div class="row g-2 align-items-end">
                            <div class="col">
                                <label class="form-label form-label-sm">Product / Service</label>
                                <CatalogCombobox Value="_newCatalogItem" ValueChanged="OnAddCatalogItemSelected" />
                            </div>
                            <div class="col-auto" style="width:90px">
                                <label class="form-label form-label-sm">Qty</label>
                                <input class="form-control form-control-sm text-end" type="number" min="1" @bind="newQty" />
                            </div>
                            <div class="col-auto" style="width:110px">
                                <label class="form-label form-label-sm">Unit Price</label>
                                <input class="form-control form-control-sm text-end" type="number" step="0.01" @bind="newUnitPrice" />
                            </div>
                            <div class="col-auto d-flex align-items-end gap-1">
                                <button class="btn btn-success btn-sm" @onclick="AddLineItem" disabled="@(lineItemSaving || _newCatalogItem is null)">
                                    @if (lineItemSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                    Add
                                </button>
                                <button class="btn btn-outline-secondary btn-sm" @onclick="CancelAdd">Cancel</button>
                            </div>
                        </div>
                        @if (newUnitPrice > 0 && newQty > 0)
                        {
                            <div class="text-muted small mt-1">Line total: @((newQty * newUnitPrice).ToString("F2"))</div>
                        }
                        @if (!string.IsNullOrEmpty(lineItemError)) { <div class="text-danger small mt-1">@lineItemError</div> }
                    </div>
                }

                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Item</th>
                                <th class="text-end">Qty</th>
                                <th class="text-end">Unit Price</th>
                                <th class="text-end">Discount %</th>
                                <th class="text-end">Line Total</th>
                                @if (order.Status == "Pending") { <th></th> }
                            </tr>
                        </thead>
                        <tbody>
                            @if (!order.LineItems.Any())
                            {
                                <tr><td colspan="6" class="text-center text-muted py-3">No line items on this order.</td></tr>
                            }
                            @foreach (var l in order.LineItems)
                            {
                                @if (editingLineItemId == l.Id)
                                {
                                    <tr class="table-warning">
                                        <td>@l.ItemName</td>
                                        <td class="text-end" style="width:90px">
                                            <input class="form-control form-control-sm text-end" type="number" min="1" @bind="editQty" />
                                        </td>
                                        <td class="text-end" style="width:110px">
                                            <input class="form-control form-control-sm text-end" type="number" step="0.01" @bind="editUnitPrice" />
                                        </td>
                                        <td class="text-end text-muted small">@l.DiscountPercent.ToString("0.##")%</td>
                                        <td class="text-end fw-semibold">@((editQty * editUnitPrice * (1 - l.DiscountPercent / 100m)).ToString("F2"))</td>
                                        <td class="text-end text-nowrap">
                                            <button class="btn btn-success btn-sm py-0 px-1 me-1" @onclick="() => SaveEdit(l.Id)" disabled="@lineItemSaving">✓</button>
                                            <button class="btn btn-outline-secondary btn-sm py-0 px-1" @onclick="CancelEdit">✕</button>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    <tr>
                                        <td>
                                            @l.ItemName
                                            @if (l.ItemType == "Service") { <span class="badge bg-info text-dark ms-1" style="font-size:9px">Service</span> }
                                            else if (l.ItemType == "Product") { <span class="badge bg-success ms-1" style="font-size:9px">Product</span> }
                                        </td>
                                        <td class="text-end">@l.Quantity</td>
                                        <td class="text-end">@l.UnitPrice.ToString("F2")</td>
                                        <td class="text-end">@(l.DiscountPercent > 0 ? $"{l.DiscountPercent:0.##}%" : "-")</td>
                                        <td class="text-end fw-semibold">@((l.LineTotal - l.DiscountAmount).ToString("F2"))</td>
                                        @if (order.Status == "Pending")
                                        {
                                            <td class="text-end text-nowrap">
                                                <button class="btn btn-outline-primary btn-sm py-0 px-1 me-1" @onclick="() => StartEdit(l)">✎</button>
                                                <button class="btn btn-outline-danger btn-sm py-0 px-1" @onclick="() => RemoveLineItem(l.Id)" disabled="@lineItemSaving">✕</button>
                                            </td>
                                        }
                                    </tr>
                                }
                            }
                            @if (order.Status == "Pending" && !showAddLineItem)
                            {
                                <tr>
                                    <td colspan="6">
                                        <button class="btn btn-link btn-sm p-0" @onclick="() => showAddLineItem = true">+ Add line item</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            @{ var cols = order.Status == "Pending" ? 5 : 4; }
                            @if (order.DiscountTotal > 0)
                            {
                                <tr>
                                    <td colspan="@cols" class="text-end text-muted">Subtotal</td>
                                    <td class="text-end">@order.SubTotal.ToString("F2")</td>
                                </tr>
                                <tr>
                                    <td colspan="@cols" class="text-end text-muted">Item Discounts</td>
                                    <td class="text-end text-danger">-@order.DiscountTotal.ToString("F2")</td>
                                </tr>
                            }
                            @if (order.DiscountTotal > 0 || order.QuoteDiscountPercent > 0 || order.TaxRatePercent > 0)
                            {
                                <tr>
                                    <td colspan="@cols" class="text-end text-muted">Net Total</td>
                                    <td class="text-end">@order.TotalAmount.ToString("F2")</td>
                                </tr>
                            }
                            @if (order.QuoteDiscountPercent > 0)
                            {
                                <tr>
                                    <td colspan="@cols" class="text-end text-muted">Quote Discount (@order.QuoteDiscountPercent.ToString("0.##")%)</td>
                                    <td class="text-end text-danger">-@order.QuoteDiscountAmount.ToString("F2")</td>
                                </tr>
                                <tr>
                                    <td colspan="@cols" class="text-end text-muted">Taxable Amount</td>
                                    <td class="text-end">@order.TaxableAmount.ToString("F2")</td>
                                </tr>
                            }
                            @if (order.TaxRatePercent > 0)
                            {
                                <tr>
                                    <td colspan="@cols" class="text-end text-muted">@order.TaxRateName (@order.TaxRatePercent.ToString("0.##")%)</td>
                                    <td class="text-end text-muted">+@order.TaxAmount.ToString("F2")</td>
                                </tr>
                            }
                            <tr class="fw-bold">
                                <td colspan="@cols" class="text-end">Grand Total</td>
                                <td class="text-end text-primary">@order.GrandTotal.ToString("F2") @order.Currency</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <!-- Actions sidebar -->
        <div class="col-md-4">
            <div class="card mb-3">
                <div class="card-header"><h6 class="mb-0">Order Actions</h6></div>
                <div class="card-body d-grid gap-2">
                    @if (order.Status == "Pending")
                    {
                        <button class="btn btn-primary btn-sm" @onclick="Confirm" disabled="@actionSaving">Confirm Order</button>
                        <button class="btn btn-outline-danger btn-sm" @onclick="() => showCancelForm = !showCancelForm">Cancel Order</button>
                    }
                    @if (order.Status == "Confirmed")
                    {
                        <button class="btn btn-warning btn-sm" @onclick="Process" disabled="@actionSaving">Start Processing</button>
                        <button class="btn btn-outline-danger btn-sm" @onclick="() => showCancelForm = !showCancelForm">Cancel Order</button>
                    }
                    @if (order.Status == "Processing")
                    {
                        <button class="btn btn-info btn-sm" @onclick="() => showShipForm = !showShipForm">Ship Order</button>
                    }
                    @if (order.Status == "Shipped")
                    {
                        <button class="btn btn-success btn-sm" @onclick="Deliver" disabled="@actionSaving">Mark Delivered</button>
                    }

                    @if (showShipForm)
                    {
                        <div class="mt-2">
                            <input class="form-control form-control-sm mb-1" @bind="trackingInfo" placeholder="Tracking number (optional)" />
                            <button class="btn btn-sm btn-info w-100" @onclick="Ship" disabled="@actionSaving">Confirm Ship</button>
                        </div>
                    }
                    @if (showCancelForm)
                    {
                        <div class="mt-2">
                            <input class="form-control form-control-sm mb-1" @bind="cancelReason" placeholder="Reason for cancellation" />
                            <button class="btn btn-sm btn-danger w-100" @onclick="Cancel" disabled="@actionSaving">Confirm Cancel</button>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(actionError)) { <div class="text-danger small">@actionError</div> }
                    @if (!string.IsNullOrEmpty(actionSuccess)) { <div class="text-success small">@actionSuccess</div> }

                    <button class="btn @(_showPreview ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="() => _showPreview = !_showPreview">
                        @(_showPreview ? "Hide Preview" : "Document Preview")
                    </button>
                    <a href="/orders" class="btn btn-outline-secondary btn-sm">Back to List</a>
                </div>
            </div>
        </div>
    </div>

    @if (_showPreview)
    {
        <div class="card mt-4 preview-doc shadow-sm">
            <div class="card-body p-4 p-md-5">
                <div class="d-flex justify-content-between align-items-start mb-4 pb-3 border-bottom">
                    <div>
                        <div class="fw-bold fs-4 lh-1 zoeily-brand" style="font-size:1.5rem!important">ZoeIly</div>
                        <div class="text-muted small mt-1">Sales Order</div>
                    </div>
                    <div class="text-end">
                        <div class="fw-bold fs-5">@order.OrderNumber</div>
                        <div class="small text-muted">Date: @order.CreatedAt.ToString("MMM dd, yyyy")</div>
                        @if (order.ShippedAt.HasValue)
                        {
                            <div class="small text-muted">Shipped: @order.ShippedAt.Value.ToString("MMM dd, yyyy")</div>
                        }
                        @if (order.DeliveredAt.HasValue)
                        {
                            <div class="small text-muted">Delivered: @order.DeliveredAt.Value.ToString("MMM dd, yyyy")</div>
                        }
                        <span class="badge @GetStatusBadge(order.Status) mt-1">@order.Status</span>
                    </div>
                </div>

                <div class="table-responsive mb-3">
                    <table class="table table-sm table-bordered mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Item</th>
                                <th class="text-end" style="width:60px">Qty</th>
                                <th class="text-end" style="width:110px">Unit Price</th>
                                <th class="text-end" style="width:90px">Discount</th>
                                <th class="text-end" style="width:110px">Line Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!order.LineItems.Any())
                            {
                                <tr><td colspan="5" class="text-center text-muted py-3">No line items on this order.</td></tr>
                            }
                            @foreach (var l in order.LineItems)
                            {
                                <tr>
                                    <td>@l.ItemName</td>
                                    <td class="text-end">@l.Quantity</td>
                                    <td class="text-end">@l.UnitPrice.ToString("F2")</td>
                                    <td class="text-end">@(l.DiscountPercent > 0 ? $"{l.DiscountPercent:0.##}%" : "—")</td>
                                    <td class="text-end fw-semibold">@((l.LineTotal - l.DiscountAmount).ToString("F2"))</td>
                                </tr>
                            }
                        </tbody>
                        @if (order.LineItems.Any())
                        {
                            <tfoot>
                                @if (order.DiscountTotal > 0)
                                {
                                    <tr class="table-light">
                                        <td colspan="4" class="text-end text-muted small">Subtotal</td>
                                        <td class="text-end">@order.SubTotal.ToString("F2")</td>
                                    </tr>
                                    <tr class="table-light">
                                        <td colspan="4" class="text-end text-muted small">Item Discounts</td>
                                        <td class="text-end text-danger">−@order.DiscountTotal.ToString("F2")</td>
                                    </tr>
                                }
                                <tr class="table-light">
                                    <td colspan="4" class="text-end text-muted small">Net Total</td>
                                    <td class="text-end">@order.TotalAmount.ToString("F2")</td>
                                </tr>
                                @if (order.QuoteDiscountPercent > 0)
                                {
                                    <tr class="table-light">
                                        <td colspan="4" class="text-end text-muted small">Quote Discount (@order.QuoteDiscountPercent.ToString("0.##")%)</td>
                                        <td class="text-end text-danger">−@order.QuoteDiscountAmount.ToString("F2")</td>
                                    </tr>
                                    <tr class="table-light">
                                        <td colspan="4" class="text-end text-muted small">Taxable Amount</td>
                                        <td class="text-end">@order.TaxableAmount.ToString("F2")</td>
                                    </tr>
                                }
                                @if (order.TaxRatePercent > 0)
                                {
                                    <tr class="table-light">
                                        <td colspan="4" class="text-end text-muted small">@order.TaxRateName (@order.TaxRatePercent.ToString("0.##")%)</td>
                                        <td class="text-end text-muted">+@order.TaxAmount.ToString("F2")</td>
                                    </tr>
                                }
                                <tr class="table-primary fw-bold">
                                    <td colspan="4" class="text-end">Grand Total (@order.Currency)</td>
                                    <td class="text-end fs-6">@order.GrandTotal.ToString("F2")</td>
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>

                @if (!string.IsNullOrWhiteSpace(order.ShippingAddress))
                {
                    <div class="border rounded px-3 py-2 mb-3 small bg-light">
                        <strong>Ship to:</strong> @order.ShippingAddress
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(order.Notes))
                {
                    <div class="border rounded px-3 py-2 mb-3 small bg-light">
                        <strong>Notes:</strong> @order.Notes
                    </div>
                }

                <div class="text-center text-muted small mt-4 pt-2 border-top">Thank you for your business.</div>
            </div>
        </div>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    private OrderDetailDto? order;
    private string? error;
    private bool actionSaving;
    private string? actionError;
    private string? actionSuccess;

    private bool _showPreview;
    private bool showShipForm;
    private string? trackingInfo;
    private bool showCancelForm;
    private string cancelReason = "";

    // Line item management
    private bool lineItemSaving;
    private string? lineItemError;

    private bool showAddLineItem;
    private CatalogItemDto? _newCatalogItem;
    private int newQty = 1;
    private decimal newUnitPrice;

    private Guid? editingLineItemId;
    private int editQty;
    private decimal editUnitPrice;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        try { order = await Api.GetOrderAsync(Id); }
        catch { error = "Failed to load order."; }
    }

    private async Task Confirm()
    {
        actionError = null; actionSuccess = null; actionSaving = true;
        try
        {
            var resp = await Api.ConfirmOrderAsync(Id);
            if (resp.IsSuccessStatusCode) { actionSuccess = "Order confirmed."; await Load(); }
            else actionError = await resp.Content.ReadAsStringAsync();
        }
        finally { actionSaving = false; }
    }

    private async Task Process()
    {
        actionError = null; actionSuccess = null; actionSaving = true;
        try
        {
            var resp = await Api.ProcessOrderAsync(Id);
            if (resp.IsSuccessStatusCode) { actionSuccess = "Order is now processing."; await Load(); }
            else actionError = await resp.Content.ReadAsStringAsync();
        }
        finally { actionSaving = false; }
    }

    private async Task Ship()
    {
        actionError = null; actionSuccess = null; actionSaving = true;
        try
        {
            var resp = await Api.ShipOrderAsync(Id, trackingInfo);
            if (resp.IsSuccessStatusCode) { showShipForm = false; actionSuccess = "Order shipped."; await Load(); }
            else actionError = await resp.Content.ReadAsStringAsync();
        }
        finally { actionSaving = false; }
    }

    private async Task Deliver()
    {
        actionError = null; actionSuccess = null; actionSaving = true;
        try
        {
            var resp = await Api.DeliverOrderAsync(Id);
            if (resp.IsSuccessStatusCode) { actionSuccess = "Order marked as delivered."; await Load(); }
            else actionError = await resp.Content.ReadAsStringAsync();
        }
        finally { actionSaving = false; }
    }

    private async Task Cancel()
    {
        actionError = null; actionSuccess = null;
        if (string.IsNullOrWhiteSpace(cancelReason)) { actionError = "Cancellation reason is required."; return; }
        actionSaving = true;
        try
        {
            var resp = await Api.CancelOrderAsync(Id, cancelReason);
            if (resp.IsSuccessStatusCode) { showCancelForm = false; actionSuccess = "Order cancelled."; await Load(); }
            else actionError = await resp.Content.ReadAsStringAsync();
        }
        finally { actionSaving = false; }
    }

    private void StartEdit(OrderLineItemDto l)
    {
        editingLineItemId = l.Id;
        editQty = l.Quantity;
        editUnitPrice = l.UnitPrice;
    }

    private void CancelEdit() => editingLineItemId = null;

    private async Task SaveEdit(Guid lineItemId)
    {
        lineItemError = null; lineItemSaving = true;
        try
        {
            var resp = await Api.UpdateOrderLineItemAsync(Id, lineItemId, new { Quantity = editQty, UnitPrice = editUnitPrice });
            if (resp.IsSuccessStatusCode) { editingLineItemId = null; await Load(); }
            else lineItemError = await resp.Content.ReadAsStringAsync();
        }
        finally { lineItemSaving = false; }
    }

    private void OnAddCatalogItemSelected(CatalogItemDto? item)
    {
        _newCatalogItem = item;
        newUnitPrice = item?.Price ?? 0;
    }

    private void CancelAdd()
    {
        showAddLineItem = false;
        _newCatalogItem = null; newQty = 1; newUnitPrice = 0;
    }

    private async Task AddLineItem()
    {
        lineItemError = null;
        if (_newCatalogItem is null) { lineItemError = "Please select an item."; return; }
        if (newQty <= 0) { lineItemError = "Quantity must be positive."; return; }
        lineItemSaving = true;
        try
        {
            var resp = await Api.AddOrderLineItemAsync(Id, new
            {
                CatalogItemId = _newCatalogItem.Id,
                ItemName = _newCatalogItem.Name,
                ItemType = _newCatalogItem.Type,
                Quantity = newQty,
                UnitPrice = newUnitPrice
            });
            if (resp.IsSuccessStatusCode)
            {
                _newCatalogItem = null; newQty = 1; newUnitPrice = 0;
                await Load();
            }
            else lineItemError = await resp.Content.ReadAsStringAsync();
        }
        finally { lineItemSaving = false; }
    }

    private async Task RemoveLineItem(Guid lineItemId)
    {
        lineItemError = null; lineItemSaving = true;
        try
        {
            var resp = await Api.DeleteOrderLineItemAsync(Id, lineItemId);
            if (resp.IsSuccessStatusCode) await Load();
            else lineItemError = await resp.Content.ReadAsStringAsync();
        }
        finally { lineItemSaving = false; }
    }

    private static string GetStatusBadge(string status) => status switch
    {
        "Delivered" => "bg-success",
        "Cancelled" => "bg-danger",
        "Shipped" => "bg-info text-dark",
        "Confirmed" => "bg-primary",
        "Processing" => "bg-warning text-dark",
        _ => "bg-secondary"
    };
}
