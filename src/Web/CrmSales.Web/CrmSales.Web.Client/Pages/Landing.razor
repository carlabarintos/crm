@code {
    // ── Form state ────────────────────────────────────────────────────
    private string _name = "";
    private string _company = "";
    private string _email = "";
    private string? _phone;
    private string? _message;
    private bool _submitting;
    private bool _submitted;
    private string? _errorMsg;
    private string? _submittedEmail;
    private bool _nameError;
    private bool _companyError;
    private bool _emailError;

    // ── Pipeline animation state ──────────────────────────────────────
    private int _activeStage = 0;
    private int _displayedValue = 0;
    private string _notification = "";
    private bool _showNotification;
    private readonly CancellationTokenSource _cts = new();

    private static readonly string[] _notifications =
    [
        "New deal added",
        "Proposal sent",
        "Quote accepted!",
    ];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _ = RunPipelineAnimationAsync(_cts.Token);
    }

    private async Task RunPipelineAnimationAsync(CancellationToken ct)
    {
        // Count pipeline value up from 0 to $108,500 over ~1 second
        const int target = 108_500;
        const int steps = 40;
        for (var i = 1; i <= steps && !ct.IsCancellationRequested; i++)
        {
            _displayedValue = target * i / steps;
            await InvokeAsync(StateHasChanged);
            await Task.Delay(22, ct);
        }
        _displayedValue = target;
        await InvokeAsync(StateHasChanged);

        // Cycle through stages with notification toasts
        var notifIdx = 0;
        while (!ct.IsCancellationRequested)
        {
            // Pause on current stage
            await Task.Delay(2200, ct);
            if (ct.IsCancellationRequested) break;

            // Pop in notification
            _notification = _notifications[notifIdx % _notifications.Length];
            _showNotification = true;
            notifIdx++;
            await InvokeAsync(StateHasChanged);

            // Hold notification briefly
            await Task.Delay(1400, ct);
            if (ct.IsCancellationRequested) break;

            // Dismiss notification and advance stage
            _showNotification = false;
            _activeStage = (_activeStage + 1) % 3;
            await InvokeAsync(StateHasChanged);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
            Navigation.NavigateTo("/dashboard", replace: true);
    }

    private async Task SubmitAsync()
    {
        _nameError = string.IsNullOrWhiteSpace(_name);
        _companyError = string.IsNullOrWhiteSpace(_company);
        _emailError = string.IsNullOrWhiteSpace(_email);

        if (_nameError || _companyError || _emailError)
        {
            _errorMsg = "Please fill in all required fields.";
            return;
        }

        _errorMsg = null;
        _submitting = true;
        try
        {
            var http = HttpClientFactory.CreateClient("anon");
            var resp = await http.PostAsJsonAsync("/api/access-requests", new
            {
                Name = _name.Trim(),
                Company = _company.Trim(),
                Email = _email.Trim(),
                Phone = _phone?.Trim(),
                Message = _message?.Trim()
            });

            if (resp.IsSuccessStatusCode)
            {
                _submittedEmail = _email.Trim();
                _submitted = true;
            }
            else
            {
                _errorMsg = "Something went wrong. Please try again.";
            }
        }
        catch
        {
            _errorMsg = "Unable to reach the server. Please try again later.";
        }
        finally
        {
            _submitting = false;
        }
    }

    public void Dispose() => _cts.Cancel();
}
