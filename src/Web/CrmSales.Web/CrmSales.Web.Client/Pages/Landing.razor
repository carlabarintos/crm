@page "/"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@attribute [AllowAnonymous]
@layout LandingLayout
@implements IDisposable
@using CrmSales.Web.Client.Services
@inject IHttpClientFactory HttpClientFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>ZoeIly CRM — Modern Sales Platform</PageTitle>

<!-- ── Hero ──────────────────────────────────────────────────────── -->
<section class="hero">
    <div class="hero-inner">
        <div class="hero-badge">Built for growing sales teams</div>
        <h1 class="hero-title">Close more deals,<br />faster than ever.</h1>
        <p class="hero-sub">
            ZoeIly gives your team one place to manage every customer relationship,
            track every deal, and turn quotes into orders — without the chaos of spreadsheets.
        </p>
        <div class="hero-actions">
            <a href="#request" class="btn btn-primary btn-lg hero-cta">Request Access</a>
            <a href="authentication/login" class="btn btn-outline-secondary btn-lg">Sign In</a>
        </div>
    </div>
</section>

<!-- ── Stats row ─────────────────────────────────────────────────── -->
<section class="stats-row">
    <div class="stats-inner">
        <div class="stat-item">
            <span class="stat-num">Full Pipeline</span>
            <span class="stat-label">Prospect to delivery, covered</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
            <span class="stat-num">Real-time</span>
            <span class="stat-label">Team notifications</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
            <span class="stat-num">Your data</span>
            <span class="stat-label">Completely isolated per company</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
            <span class="stat-num">Always on</span>
            <span class="stat-label">Reliable and fast</span>
        </div>
    </div>
</section>

<!-- ── What is a CRM? ─────────────────────────────────────────────── -->
<section class="crm-explainer">
    <div class="crm-explainer-inner">
        <div class="crm-text">
            <div class="crm-eyebrow">New to CRM?</div>
            <h2>Your business runs on relationships.<br />A CRM makes sure nothing slips.</h2>
            <p>
                A <strong>CRM — Customer Relationship Management</strong> system is the command centre
                for your sales operation. It keeps every customer, conversation, deal, and document
                in one organised place, so your team always knows what's happening and what to do next.
            </p>
            <p>
                Without a CRM, deals fall through the cracks, follow-ups get forgotten, and
                your best leads go cold while you're stuck digging through emails and spreadsheets.
                With ZoeIly, your entire pipeline is visible, searchable, and always up to date.
            </p>
            <div class="crm-bullets">
                <div class="crm-bullet">
                    <div class="crm-bullet-dot"></div>
                    <span>Know exactly where every deal stands — at a glance</span>
                </div>
                <div class="crm-bullet">
                    <div class="crm-bullet-dot"></div>
                    <span>Never miss a follow-up or let a quote expire unnoticed</span>
                </div>
                <div class="crm-bullet">
                    <div class="crm-bullet-dot"></div>
                    <span>Give every team member the context they need, instantly</span>
                </div>
                <div class="crm-bullet">
                    <div class="crm-bullet-dot"></div>
                    <span>Turn contacts into customers with a clear, repeatable process</span>
                </div>
            </div>
        </div>

        <!-- ── Animated pipeline preview ── -->
        <div class="crm-visual">
            <div class="pipeline-preview">
                <div class="pipeline-header">
                    <span>
                        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" style="margin-right:5px;vertical-align:middle">
                            <circle cx="6" cy="6" r="5" fill="#dcfce7" stroke="#86efac" stroke-width="1"/>
                            <circle cx="6" cy="6" r="2.5" fill="#22c55e"/>
                        </svg>
                        Sales Pipeline — Live
                    </span>
                    <div class="pl-notif @(_showNotification ? "pl-notif-show" : "")">
                        <span class="pl-notif-dot"></span>@_notification
                    </div>
                </div>

                <div class="pipeline-stages">
                    <!-- Prospecting -->
                    <div class="pl-stage @(_activeStage == 0 ? "pl-stage-active" : "")">
                        <div class="pl-stage-label">
                            Prospecting
                            @if (_activeStage == 0)
                            {
                                <span class="pl-active-badge">●</span>
                            }
                        </div>
                        <div class="pl-deal pl-deal-1 @(_activeStage == 0 ? "pl-deal-glow" : "")">
                            <span class="pl-deal-name">Acme Corp</span>
                            <span class="pl-deal-value">$12k</span>
                        </div>
                        <div class="pl-deal pl-deal-2">
                            <span class="pl-deal-name">Blue Sky Ltd</span>
                            <span class="pl-deal-value">$4.5k</span>
                        </div>
                    </div>

                    <!-- Proposal -->
                    <div class="pl-stage @(_activeStage == 1 ? "pl-stage-active" : "")">
                        <div class="pl-stage-label">
                            Proposal
                            @if (_activeStage == 1)
                            {
                                <span class="pl-active-badge pl-badge-amber">●</span>
                            }
                        </div>
                        <div class="pl-deal pl-deal-3 @(_activeStage == 1 ? "pl-deal-glow" : "")">
                            <span class="pl-deal-name">Nova Tech</span>
                            <span class="pl-deal-value">$28k</span>
                        </div>
                    </div>

                    <!-- Closing -->
                    <div class="pl-stage @(_activeStage == 2 ? "pl-stage-active" : "")">
                        <div class="pl-stage-label">
                            Closing
                            @if (_activeStage == 2)
                            {
                                <span class="pl-active-badge pl-badge-green">●</span>
                            }
                        </div>
                        <div class="pl-deal pl-deal-4 @(_activeStage == 2 ? "pl-deal-glow" : "")">
                            <span class="pl-deal-name">Apex Group</span>
                            <span class="pl-deal-value">$55k</span>
                        </div>
                        <div class="pl-deal pl-deal-5">
                            <span class="pl-deal-name">Vertex Inc</span>
                            <span class="pl-deal-value">$9k</span>
                        </div>
                    </div>
                </div>

                <!-- Stage progress track -->
                <div class="pl-track">
                    <div class="pl-track-dot @(_activeStage >= 0 ? "pl-track-dot-on" : "") @(_activeStage == 0 ? "pl-track-dot-pulse" : "")"></div>
                    <div class="pl-track-line @(_activeStage >= 1 ? "pl-track-line-on" : "")"></div>
                    <div class="pl-track-dot @(_activeStage >= 1 ? "pl-track-dot-on" : "") @(_activeStage == 1 ? "pl-track-dot-pulse" : "")"></div>
                    <div class="pl-track-line @(_activeStage >= 2 ? "pl-track-line-on" : "")"></div>
                    <div class="pl-track-dot @(_activeStage >= 2 ? "pl-track-dot-on" : "") @(_activeStage == 2 ? "pl-track-dot-pulse" : "")"></div>
                </div>

                <div class="pipeline-total">
                    Pipeline value
                    <strong>$@_displayedValue.ToString("N0")</strong>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ── Features ──────────────────────────────────────────────────── -->
<section class="features">
    <div class="section-header">
        <h2>Everything your sales team needs</h2>
        <p>From first contact to final delivery, ZoeIly covers the full sales lifecycle in one unified platform.</p>
    </div>
    <div class="features-grid">
        <div class="feat-card">
            <div class="feat-icon feat-indigo">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M2 14l5-5 4 4 5-6" stroke-linecap="round" stroke-linejoin="round" />
                    <circle cx="17" cy="7" r="2" fill="#6366f1" stroke="none" />
                </svg>
            </div>
            <h3>Full Sales Pipeline</h3>
            <p>Track deals from first contact through closed-won with stage analytics, weighted forecasting, and activity logging.</p>
        </div>
        <div class="feat-card">
            <div class="feat-icon feat-purple">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M10 2a7 7 0 0 1 7 7v3l1.5 2.5H1.5L3 12V9A7 7 0 0 1 10 2z" stroke-linecap="round" stroke-linejoin="round" />
                    <path d="M7.5 17.5a2.5 2.5 0 0 0 5 0" stroke-linecap="round" />
                </svg>
            </div>
            <h3>Instant Team Alerts</h3>
            <p>The moment a quote is accepted or an order ships, your whole team knows. No more chasing updates in group chats.</p>
        </div>
        <div class="feat-card">
            <div class="feat-icon feat-emerald">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="1" y="8" width="10" height="11" rx="1.5" />
                    <rect x="11" y="3" width="8" height="16" rx="1.5" />
                    <path d="M4 12v1M4 15v1M14 8v1M14 12v1M14 15v1" stroke-linecap="round" />
                </svg>
            </div>
            <h3>Quotes &amp; Orders</h3>
            <p>Build professional quotes with line items, discounts, and tax in seconds — then convert them to orders with one click.</p>
        </div>
        <div class="feat-card">
            <div class="feat-icon feat-orange">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M11 2L3 11h7l-1 7 8-10h-7l1-6z" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </div>
            <h3>Designed to be Fast</h3>
            <p>No sluggish page loads, no waiting. ZoeIly is built for speed so your team can work without frustration.</p>
        </div>
        <div class="feat-card">
            <div class="feat-icon feat-teal">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="10" cy="7" r="4" />
                    <path d="M2 18c0-3.3 3.6-6 8-6s8 2.7 8 6" stroke-linecap="round" />
                </svg>
            </div>
            <h3>Contact Management</h3>
            <p>Centralise every customer, link them to deals and orders, and keep a complete interaction history in one place.</p>
        </div>
        <div class="feat-card">
            <div class="feat-icon feat-rose">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="2" y="4" width="16" height="13" rx="2" />
                    <path d="M2 8h16" stroke-linecap="round" />
                    <path d="M6 2v3M14 2v3" stroke-linecap="round" />
                    <path d="M6 12h3M6 15h5" stroke-linecap="round" />
                </svg>
            </div>
            <h3>Audit &amp; Accountability</h3>
            <p>Every action is logged — who did what and when. Full visibility for managers, full accountability for the team.</p>
        </div>
    </div>
</section>

<!-- ── How it works ───────────────────────────────────────────────── -->
<section class="how-it-works">
    <div class="section-header">
        <h2>Up and running in one business day</h2>
        <p>We handle setup so you can focus on selling from day one.</p>
    </div>
    <div class="steps">
        <div class="step">
            <div class="step-num">1</div>
            <h4>Request access</h4>
            <p>Fill out the short form below. Tell us your company name and what you're hoping to achieve.</p>
        </div>
        <div class="step-arrow">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#D1D5DB" stroke-width="1.5">
                <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </div>
        <div class="step">
            <div class="step-num">2</div>
            <h4>We set up your workspace</h4>
            <p>Our team provisions a fully private workspace for your company — usually within one business day.</p>
        </div>
        <div class="step-arrow">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#D1D5DB" stroke-width="1.5">
                <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </div>
        <div class="step">
            <div class="step-num">3</div>
            <h4>Start selling</h4>
            <p>Log in, invite your team, and start tracking deals, quotes, and customers right away.</p>
        </div>
    </div>
</section>

<!-- ── Request access form ────────────────────────────────────────── -->
<section class="request-section" id="request">
    <div class="request-card">
        <div class="request-header">
            <h2>Request Access</h2>
            <p>Tell us about your team and we'll have your workspace ready within one business day.</p>
        </div>

        @if (_submitted)
        {
            <div class="req-success">
                <div class="req-success-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5">
                        <polyline points="20 6 9 17 4 12" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </div>
                <div>
                    <strong>Request received!</strong>
                    <p>We'll be in touch at <strong>@_submittedEmail</strong> within one business day.</p>
                </div>
            </div>
        }
        else
        {
            <div class="req-form">
                <div class="req-row">
                    <div class="req-field">
                        <label>Full Name <span class="req-star">*</span></label>
                        <input class="form-control @(_nameError ? "is-invalid" : "")"
                               @bind="_name" placeholder="Jane Smith" />
                    </div>
                    <div class="req-field">
                        <label>Company Name <span class="req-star">*</span></label>
                        <input class="form-control @(_companyError ? "is-invalid" : "")"
                               @bind="_company" placeholder="Acme Corp" />
                    </div>
                </div>
                <div class="req-row">
                    <div class="req-field">
                        <label>Work Email <span class="req-star">*</span></label>
                        <input type="email" class="form-control @(_emailError ? "is-invalid" : "")"
                               @bind="_email" placeholder="jane@acme.com" />
                    </div>
                    <div class="req-field">
                        <label>Phone <span class="req-optional">(optional)</span></label>
                        <input type="tel" class="form-control" @bind="_phone" placeholder="+1 555 000 0000" />
                    </div>
                </div>
                <div class="req-field">
                    <label>Tell us about your use case <span class="req-optional">(optional)</span></label>
                    <textarea class="form-control" rows="3" @bind="_message"
                              placeholder="We have a 5-person sales team and want to track opportunities, generate quotes…"></textarea>
                </div>
                @if (!string.IsNullOrEmpty(_errorMsg))
                {
                    <div class="alert alert-danger py-2 mb-0">@_errorMsg</div>
                }
                <button class="btn btn-primary w-100 req-submit-btn" @onclick="SubmitAsync" disabled="@_submitting">
                    @if (_submitting)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    }
                    Send Request
                </button>
                <p class="req-note">No credit card. No commitment. Just a workspace ready for your team.</p>
            </div>
        }
    </div>
</section>

<style>
    /* ── Hero ──────────────────────────────────────────────────────── */
    .hero {
        padding: 7rem 1.5rem 5rem;
        text-align: center;
        background: linear-gradient(160deg, #f5f3ff 0%, #eff6ff 55%, #f9fafb 100%);
    }
    .hero-inner { max-width: 740px; margin: 0 auto; }
    .hero-badge {
        display: inline-block;
        background: #ede9fe; color: #5b21b6;
        font-size: 11.5px; font-weight: 700;
        border-radius: 99px; padding: 5px 16px;
        margin-bottom: 1.75rem;
        letter-spacing: .06em; text-transform: uppercase;
    }
    .hero-title {
        font-size: clamp(2.25rem, 5.5vw, 3.75rem);
        font-weight: 900; color: #111827;
        line-height: 1.1; margin-bottom: 1.25rem;
    }
    .hero-sub {
        font-size: 1.1rem; color: #4B5563;
        max-width: 540px; margin: 0 auto 2.25rem;
        line-height: 1.7;
    }
    .hero-actions { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
    .hero-cta {
        font-size: 1rem; padding: .8rem 2.25rem;
        border-radius: 10px;
        box-shadow: 0 4px 16px rgba(99,102,241,.35);
    }

    /* ── Stats ─────────────────────────────────────────────────────── */
    .stats-row {
        background: #fff;
        border-top: 1px solid #E5E7EB;
        border-bottom: 1px solid #E5E7EB;
    }
    .stats-inner {
        display: flex; align-items: center; justify-content: center;
        flex-wrap: wrap; gap: 0;
        max-width: 900px; margin: 0 auto;
        padding: 2rem 1.5rem;
    }
    .stat-item { text-align: center; padding: .75rem 2.5rem; }
    .stat-num { display: block; font-size: 1.2rem; font-weight: 800; color: #111827; }
    .stat-label { display: block; font-size: 12px; color: #6B7280; margin-top: 2px; }
    .stat-divider { width: 1px; height: 40px; background: #E5E7EB; flex-shrink: 0; }

    /* ── CRM Explainer ──────────────────────────────────────────────── */
    .crm-explainer { padding: 5.5rem 1.5rem; background: #fff; }
    .crm-explainer-inner {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4rem; align-items: center;
        max-width: 1060px; margin: 0 auto;
    }
    .crm-eyebrow {
        display: inline-block;
        font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
        color: #6366f1; background: #eef2ff;
        border-radius: 99px; padding: 4px 12px;
        margin-bottom: 1rem;
    }
    .crm-text h2 {
        font-size: clamp(1.5rem, 2.5vw, 2rem);
        font-weight: 800; color: #111827;
        line-height: 1.2; margin-bottom: 1.125rem;
    }
    .crm-text p { font-size: 14.5px; color: #4B5563; line-height: 1.75; margin-bottom: 1rem; }
    .crm-bullets { margin-top: 1.5rem; display: flex; flex-direction: column; gap: .75rem; }
    .crm-bullet { display: flex; align-items: flex-start; gap: .75rem; }
    .crm-bullet-dot {
        width: 8px; height: 8px; border-radius: 50%;
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        flex-shrink: 0; margin-top: 6px;
    }
    .crm-bullet span { font-size: 14px; color: #374151; line-height: 1.5; }

    /* ── Pipeline preview ───────────────────────────────────────────── */
    .pipeline-preview {
        background: #F9FAFB; border: 1px solid #E5E7EB;
        border-radius: 16px; padding: 1.25rem;
        box-shadow: 0 8px 32px rgba(0,0,0,.07);
        user-select: none;
    }

    .pipeline-header {
        display: flex; align-items: center; justify-content: space-between;
        font-size: 11.5px; font-weight: 700; color: #6B7280;
        letter-spacing: .04em; text-transform: uppercase;
        margin-bottom: .875rem;
    }

    /* Notification toast */
    .pl-notif {
        display: inline-flex; align-items: center; gap: 5px;
        font-size: 10.5px; font-weight: 600;
        color: #166534; background: #dcfce7; border: 1px solid #86efac;
        border-radius: 99px; padding: 3px 9px;
        opacity: 0; transform: translateY(-6px) scale(.95);
        transition: opacity .35s ease, transform .35s ease;
        text-transform: none; letter-spacing: 0;
    }
    .pl-notif-show { opacity: 1; transform: translateY(0) scale(1); }
    .pl-notif-dot {
        width: 6px; height: 6px; border-radius: 50%;
        background: #22c55e;
        animation: notifPulse 1.2s ease-in-out infinite;
    }
    @@keyframes notifPulse {
        0%, 100% { opacity: 1; }
        50% { opacity: .4; }
    }

    /* Stage columns */
    .pipeline-stages { display: flex; gap: .5rem; }
    .pl-stage {
        flex: 1; border-radius: 10px; padding: .5rem .375rem;
        border: 1.5px solid transparent;
        transition: background .4s ease, border-color .4s ease;
    }
    .pl-stage-active {
        background: rgba(99,102,241,.05);
        border-color: rgba(99,102,241,.2);
    }

    .pl-stage-label {
        font-size: 10px; font-weight: 700; color: #9CA3AF;
        text-transform: uppercase; letter-spacing: .06em;
        margin-bottom: .4rem;
        display: flex; align-items: center; justify-content: space-between;
    }

    .pl-active-badge {
        font-size: 10px; color: #a78bfa;
        animation: badgePop .25s ease both, badgeBlink 1.4s ease-in-out infinite .25s;
    }
    .pl-badge-amber { color: #f59e0b; }
    .pl-badge-green { color: #22c55e; }
    @@keyframes badgePop {
        from { transform: scale(0); opacity: 0; }
        to   { transform: scale(1); opacity: 1; }
    }
    @@keyframes badgeBlink {
        0%, 100% { opacity: 1; }
        50%      { opacity: .35; }
    }

    /* Deal cards */
    .pl-deal {
        display: flex; justify-content: space-between; align-items: center;
        font-size: 11.5px; font-weight: 500; color: #374151;
        background: #fff; border: 1.5px solid #E5E7EB;
        border-radius: 8px; padding: .4rem .5rem;
        margin-bottom: .3rem;
        border-left: 3px solid transparent;
        transition: border-color .4s ease, box-shadow .4s ease;
        animation: dealSlideIn .5s ease both;
    }
    .pl-deal-1 { border-left-color: #a78bfa; animation-delay: .05s; }
    .pl-deal-2 { border-left-color: #a78bfa; animation-delay: .15s; }
    .pl-deal-3 { border-left-color: #34d399; animation-delay: .25s; }
    .pl-deal-4 { border-left-color: #fbbf24; animation-delay: .35s; }
    .pl-deal-5 { border-left-color: #fbbf24; animation-delay: .45s; }
    @@keyframes dealSlideIn {
        from { opacity: 0; transform: translateY(8px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .pl-deal-glow {
        border-color: #c4b5fd;
        box-shadow: 0 0 0 3px rgba(139,92,246,.12), 0 2px 8px rgba(139,92,246,.15);
        animation: dealSlideIn .5s ease both, dealGlowPulse 1.8s ease-in-out infinite .5s;
    }
    @@keyframes dealGlowPulse {
        0%, 100% { box-shadow: 0 0 0 3px rgba(139,92,246,.12), 0 2px 8px rgba(139,92,246,.15); }
        50%      { box-shadow: 0 0 0 5px rgba(139,92,246,.18), 0 4px 14px rgba(139,92,246,.22); }
    }
    .pl-deal-name { font-size: 11px; color: #374151; }
    .pl-deal-value { font-size: 11px; font-weight: 700; color: #6366f1; }

    /* Progress track */
    .pl-track {
        display: flex; align-items: center; gap: 0;
        margin: .875rem 0 .625rem; padding: 0 .25rem;
    }
    .pl-track-dot {
        width: 10px; height: 10px; border-radius: 50%;
        background: #E5E7EB; flex-shrink: 0;
        transition: background .5s ease, box-shadow .5s ease;
    }
    .pl-track-dot-on { background: #6366f1; }
    .pl-track-dot-pulse {
        box-shadow: 0 0 0 3px rgba(99,102,241,.25);
        animation: trackDotPulse 1.2s ease-in-out infinite;
    }
    @@keyframes trackDotPulse {
        0%, 100% { box-shadow: 0 0 0 3px rgba(99,102,241,.25); }
